{"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"initializeSDK"},{"kind":"text","text":"("},{"kind":"externalParam","text":"viewController"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UIViewController","text":"UIViewController"},{"kind":"text","text":", "},{"kind":"externalParam","text":"token"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" = \"\", "},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"email"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"phone"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil)"}],"platforms":["iOS"],"languages":["swift"]}]},{"parameters":[{"name":"viewController","content":[{"inlineContent":[{"text":"The UIKit view controller to present from. Must be","type":"text"},{"text":" ","type":"text"},{"text":"in an active view hierarchy when the call is made.","type":"text"}],"type":"paragraph"}]},{"name":"token","content":[{"inlineContent":[{"text":"Reserved for future per-session tokens. Leave as the default","type":"text"},{"text":" ","type":"text"},{"text":"empty string unless instructed otherwise — the SDK authenticates","type":"text"},{"text":" ","type":"text"},{"text":"against the configured website token today.","type":"text"}],"type":"paragraph"}]},{"name":"name","content":[{"type":"paragraph","inlineContent":[{"text":"The contact’s full display name. ","type":"text"},{"code":"nil","type":"codeVoi