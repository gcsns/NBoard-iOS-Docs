ce","code":"\"+15551234567\""},{"type":"text","text":"). Non-"},{"type":"codeVoice","code":"+"},{"type":"text","text":" numbers are treated as Indian"},{"type":"text","text":" "},{"type":"codeVoice","code":"+91"},{"type":"text","text":" numbers for HMAC hashing; pass fully-qualified E.164 numbers"},{"type":"text","text":" "},{"type":"text","text":"if you target other regions."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"mentions","mentions":["doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GettingStarted"]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The widget fetches the latest configuration for the configured website"},{"type":"text","text":" "},{"type":"text","text":"token, upserts the contact with whatever identity fields you pass, and"},{"type":"text","text":" "},{"type":"text","text":"then presents the welcome screens. When the user proceeds, they land on"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"text","text":"doc:ConversationList"},{"type":"text","text":", from which they can resume or start a"},{"type":"text","text":" "},{"type":"text","text":"conversation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Call this once per “open support” gesture from the host app — the"},{"type":"text","text":" "},{"type":"text","text":"presentation is full-screen so the widget owns the whole view hierarchy"},{"type":"text","text":" "},{"type":"text","text":"until the user dismisses it."}],"type":"paragraph"},{"syntax":"swift","code":["GcWidgetSDK.shared.initializeSDK(","    viewController: self,","    name: currentUser.displayName,","    email: currentUser.email,","    phone: currentUser.phoneNumber",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Identity fields are optional. If you pass any of "},{"code":"name","type":"codeVoice"},{"type":"text","text":", "},{"code":"email","type":"codeVoice"},{"type":"te