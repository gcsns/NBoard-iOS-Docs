{"variants":[{"paths":["\/documentation\/gcwidgetsdk\/gcwidgetsdk\/chatevents"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[],"metadata":{"role":"symbol","externalID":"s:11GCWidgetSDK08GcWidgetB0C10chatEventsScSyAA0C9ChatEventOGvp","title":"chatEvents","symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"chatEvents"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:11GCWidgetSDK11GcChatEventO","text":"GcChatEvent"},{"kind":"text","text":">"}],"modules":[{"name":"GCWidgetSDK"}],"roleHeading":"Instance Property"},"identifier":{"url":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/chatEvents","interfaceLanguage":"swift"},"abstract":[{"text":"An async stream of real-time chat events produced by the SDK’s","type":"text"},{"text":" ","type":"text"},{"text":"WebSocket connection.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK","doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chatEvents","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","preciseIdentifier":"s:ScS","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"GcChatEvent","preciseIdentifier":"s:11GCWidgetSDK11GcChatEventO","kind":"typeIdentifier","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcChatEvent"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GettingStarted"],"kind":"mentions"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Subscribe from a SwiftUI view’s ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" — or from any ","type":"text"},{"code":"Task","type":"codeVoice"},{"text":" in a","type":"text"},{"text":" ","type":"text"},{"text":"UIKit host — to receive ","type":"text"},{"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcChatEvent","isActive":true,"type":"reference"},{"text":" values as they arrive.","type":"text"},{"text":" ","type":"text"},{"text":"Each access returns a ","type":"text"},{"inlineContent":[{"text":"fresh, independent stream","type":"text"}],"type":"strong"},{"text":": you can have","type":"text"},{"type":"text","text":" "},{"text":"multiple concurrent subscribers (for example, a list screen watching","type":"text"},{"type":"text","text":" "},{"text":"for new conversations and an open thread watching for new messages)","type":"text"},{"type":"text","text":" "},{"text":"and each receives every event.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".task {","    for await event in GcWidgetSDK.shared.chatEvents {","        switch event {","        case .messageReceived(let msg):","            \/\/ Append to the thread for msg.conversationId","        case .messageUpdated(let msg)","            where msg.lastEvent == \"message.bot_stream_error\":","            \/\/ Show the error bubble + retry affordance","        case .socketReconnected:","            \/\/ Refetch list \/ thread to recover anything missed","        default:","            break","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The stream stays live as long as your "},{"type":"codeVoice","code":"Task"},{"type":"text","text":" retains it. Cancelling"},{"type":"text","text":" "},{"type":"text","text":"the task terminates the stream and releases its bookkeeping — no"},{"type":"text","text":" "},{"type":"text","text":"manual removal call is needed. This mirrors the"},{"type":"text","text":" "},{"type":"codeVoice","code":"GcChatEventListener"},{"type":"text","text":" fan-out, adapted to Swift’s native"},{"type":"text","text":" "},{"type":"text","text":"concurrency model."}],"type":"paragraph"},{"inlineContent":[{"text":"Events begin flowing once","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/initialize(websiteToken:baseUrl:certificatePins:socketHeaders:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/setUser(accessToken:identifier:identifierToken:name:email:phoneNumber:customAttributes:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"have succeeded and the underlying WebSocket is connected. Events"},{"type":"text","text":" "},{"type":"text","text":"produced before a subscriber attaches are not replayed."}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"The closure-based P0 API ("},{"code":"Result<Void, GcBotErrors>","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"twins) intentionally does not have a listener equivalent — the"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" surface here is the single supported way to observe"},{"type":"text","text":" "},{"type":"text","text":"real-time events, matching the locked design decision that"},{"type":"text","text":" "},{"type":"text","text":"delegate protocols feel foreign on iOS."}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"references":{"doc://com.gamechange.GCWidgetSDK/documentation/GCWidgetSDK/GcChatEvent":{"role":"symbol","kind":"symbol","title":"GcChatEvent","abstract":[{"t