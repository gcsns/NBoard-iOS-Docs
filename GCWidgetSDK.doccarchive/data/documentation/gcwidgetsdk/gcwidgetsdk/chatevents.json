{"kind":"symbol","metadata":{"symbolKind":"property","modules":[{"name":"GCWidgetSDK"}],"externalID":"s:11GCWidgetSDK08GcWidgetB0C10chatEventsScSyAA0C9ChatEventOGvp","role":"symbol","title":"chatEvents","roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chatEvents","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:11GCWidgetSDK11GcChatEventO","text":"GcChatEvent","kind":"typeIdentifier"},{"kind":"text","text":">"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK","doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK"]]},"abstract":[{"text":"An async stream of real-time chat events produced by the SDK’s","type":"text"},{"type":"text","text":" "},{"text":"WebSocket connection.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"chatEvents","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcChatEvent","text":"GcChatEvent","preciseIdentifier":"s:11GCWidgetSDK11GcChatEventO","kind":"typeIdentifier"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["iOS"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GettingStarted"]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Subscribe from a SwiftUI view’s ","type":"text"},{"type":"codeVoice","code":".task"},{"text":" — or from any ","type":"text"},{"type":"codeVoice","code":"Task"},{"text":" in a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"UIKit host — to receive "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcChatEvent"},{"type":"text","text":" values as they arrive."},{"type":"text","text":" "},{"type":"text","text":"Each access returns a "},{"type":"strong","inlineContent":[{"type":"text","text":"fresh, independent stream"}]},{"type":"text","text":": you can have"},{"type":"text","text":" "},{"type":"text","text":"multiple concurrent subscribers (for example, a list screen watching"},{"type":"text","text":" "},{"type":"text","text":"for new conversations and an open thread watching for new messages)"},{"type":"text","text":" "},{"type":"text","text":"and each receives every event."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":[".task {","    for await event in GcWidgetSDK.shared.chatEvents {","        switch event {","        case .messageReceived(let msg):","            \/\/ Append to the thread for msg.conversationId","        case .messageUpdated(let msg)","            where msg.lastEvent == \"message.bot_stream_error\":","            \/\/ Show the error bubble + retry affordance","        case .socketReconnected:","            \/\/ Refetch list \/ thread to recover anything missed","        default:","            break","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"The stream stays live as long as your "},{"type":"codeVoice","code":"Task"},{"type":"text","text":" retains it. Cancelling"},{"type":"text","text":" "},{"type":"text","text":"the task terminates the stream and releases its bookkeeping — no"},{"type":"text","text":" "},{"type":"text","text":"manual removal call is needed. This mirrors the Android SDK’s"},{"type":"text","text":" "},{"code":"GcChatEventListener","type":"codeVoice"},{"text":" fan-out, adapted to Swift’s native","type":"text"},{"text":" ","type":"text"},{"text":"concurrency model.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Events begin flowing once","type":"text"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/initialize(websiteToken:baseUrl:)","type":"reference"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/setUser(accessToken:identifier:identifierHash:name:email:phoneNumber:customAttributes:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"have succeeded and the underlying WebSocket is connected. Events"},{"type":"text","text":" "},{"type":"text","text":"produced before a subscriber attaches are not replayed."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"The closure-based P0 API (","type":"text"},{"code":"Result<Void, GcBotErrors>","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"twins) intentionally does not have a listener equivalent — the"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"text":" surface here is the single supported way to observe","type":"text"},{"type":"text","text":" "},{"type":"text","text":"real-time events, matching the locked design decision that"},{"type":"text","text":" "},{"type":"text","text":"delegate protocols feel foreign on iOS."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"}]}],"identifier":{"url":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/chatEvents","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gcwidgetsdk\/gcwidgetsdk\/chatevents"]}],"references":{"doc://com.gamechange.GCWidgetSDK/documentation/GCWidgetSDK/GcWidgetSDK/initialize(websiteToken:baseUrl:)":{"kind":"symbol","role":"symbol","title":"initialize(websiteToken:baseUrl:)",