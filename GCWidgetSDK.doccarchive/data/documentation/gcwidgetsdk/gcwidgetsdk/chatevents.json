{"abstract":[{"type":"text","text":"An async stream of real-time chat events produced by the SDK’s"},{"type":"text","text":" "},{"type":"text","text":"WebSocket connection."}],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chatEvents","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"GcChatEvent","kind":"typeIdentifier","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcChatEvent","preciseIdentifier":"s:11GCWidgetSDK11GcChatEventO"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GettingStarted"]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Subscribe from a SwiftUI view’s "},{"type":"codeVoice","code":".task"},{"type":"text","text":" — or from any "},{"type":"codeVoice","code":"Task"},{"type":"text","text":" in a"},{"type":"text","text":" "},{"type":"text","text":"UIKit host — to receive "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcChatEvent","isActive":true},{"type":"text","text":" values as they arrive."},{"type":"text","text":" "},{"type":"text","text":"Each access returns a "},{"type":"strong","inlineContent":[{"type":"text","text":"fresh, independent stream"}]},{"type":"text","text":": you can have"},{"type":"text","text":" "},{"type":"text","text":"multiple concurrent subscribers (for example, a list screen watching"},{"type":"text","text":" "},{"type":"text","text":"for new conversations and an open thread watching for new messages)"},{"type":"text","text":" "},{"type":"text","text":"and each receives every event."}]},{"type":"codeListing","code":[".task {","    for await event in GcWidgetSDK.shared.chatEvents {","        switch event {","        case .messageReceived(let msg):","            \/\/ Append to the thread for msg.conversationId","        case .messageUpdated(let msg)","            where msg.lastEvent == \"message.bot_stream_error\":","            \/\/ Show the error bubble + retry affordance","        case .socketReconnected:","            \/\/ Refetch list \/ thread to recover anything missed","        default:","            break","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The stream stays live as long as your "},{"type":"codeVoice","code":"Task"},{"type":"text","text":" retains it. Cancelling"},{"type":"text","text":" "},{"type":"text","text":"the task terminates the stream and releases its bookkeeping — no"},{"type":"text","text":" "},{"type":"text","text":"manual removal call is needed. This mirrors the Android SDK’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"GcChatEventListener"},{"type":"text","text":" fan-out, adapted to Swift’s native"},{"type":"text","text":" "},{"type":"text","text":"concurrency model."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Events begin flowing once"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/initialize(websiteToken:baseUrl:socketHeaders:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/setUser(accessToken:identifier:identifierHash:name:email:phoneNumber:customAttributes:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"have succeeded and the underlying WebSocket is connected. Events"},{"type":"text","text":" "},{"type":"text","text":"produced before a subscriber attaches are not replayed."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The closure-based P0 API ("},{"code":"Result<Void, GcBotErrors>","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"twins) intentionally does not have a listener equivalent — the"},{"type":"text","text":" "},{"code":"AsyncStream","type":"codeVoice"},{"type":"text","text":" surface here is the single supported way to observe"},{"type":"text","text":" "},{"type":"text","text":"real-time events, matching the locked design decision that"},{"type":"text","text":" "},{"type":"text","text":"delegate protocols feel foreign on iOS."}]}],"style":"note","name":"Note"}],"kind":"content"}],"metadata":{"modules":[{"name":"GCWidgetSDK"}],"symbolKind":"property","externalID":"s:11GCWidgetSDK08GcWidgetB0C10chatEventsScSyAA0C9ChatEventOGvp","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chatEvents","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"GcChatEvent","kind":"typeIdentifier","preciseIdentifier":"s:11GCWidgetSDK11GcChatEventO"},{"text":">","kind":"text"}],"title":"chatEvents","roleHeading":"Instance Property"},"variants":[{"paths":["\/documentation\/gcwidgetsdk\/gcwidgetsdk\/chatevents"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/chatEvents","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK","doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK"]]},"kind":"symbol","sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://com.gamechange.GCWidgetSDK/documentation/GCWidgetSDK":{"url":"\/documentation\/gcwidgetsdk","type":"topic","role":"collection","identifier"