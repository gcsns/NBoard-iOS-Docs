{"sections":[],"abstract":[{"type":"text","text":"An async stream of real-time chat events produced by the SDK’s"},{"type":"text","text":" "},{"type":"text","text":"WebSocket connection."}],"metadata":{"symbolKind":"property","title":"chatEvents","roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chatEvents","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:11GCWidgetSDK11GcChatEventO","text":"GcChatEvent","kind":"typeIdentifier"},{"text":">","kind":"text"}],"modules":[{"name":"GCWidgetSDK"}],"externalID":"s:11GCWidgetSDK08GcWidgetB0C10chatEventsScSyAA0C9ChatEventOGvp","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK","doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/chatEvents"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chatEvents","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcChatEvent","preciseIdentifier":"s:11GCWidgetSDK11GcChatEventO","text":"GcChatEvent","kind":"typeIdentifier"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"mentions","mentions":["doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GettingStarted"]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Subscribe from a SwiftUI view’s ","type":"text"},{"type":"codeVoice","code":".task"},{"text":" — or from any ","type":"text"},{"type":"codeVoice","code":"Task"},{"text":" in a","type":"text"},{"text":" ","type":"text"},{"text":"UIKit host — to receive ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcChatEvent"},{"text":" values as they arrive.","type":"text"},{"text":" ","type":"text"},{"text":"Each access returns a ","type":"text"},{"type":"strong","inlineContent":[{"text":"fresh, independent stream","type":"text"}]},{"text":": you can have","type":"text"},{"text":" ","type":"text"},{"text":"multiple concurrent subscribers (for example, a list screen watching","type":"text"},{"text":" ","type":"text"},{"text":"for new conversations and an open thread watching for new messages)","type":"text"},{"text":" ","type":"text"},{"text":"and each receives every event.","type":"text"}]},{"type":"codeListing","code":[".task {","    for await event in GcWidgetSDK.shared.chatEvents {","        switch event {","        case .messageReceived(let msg):","            \/\/ Append to the thread for msg.conversationId","        case .messageUpdated(let msg)","            where msg.lastEvent == \"message.bot_stream_error\":","            \/\/ Show the error bubble + retry affordance","        case .socketReconnected:","            \/\/ Refetch list \/ thread to recover anything missed","        default:","            break","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The stream stays live as long as your ","type":"text"},{"type":"codeVoice","code":"Task"},{"text":" retains it. Cancelling","type":"text"},{"text":" ","type":"text"},{"text":"the task terminates the stream and releases its bookkeeping — no","type":"text"},{"text":" ","type":"text"},{"text":"manual removal call is needed. This mirrors the Android SDK’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"GcChatEventListener"},{"text":" fan-out, adapted to Swift’s native","type":"text"},{"text":" ","type":"text"},{"text":"concurrency model.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Events begin flowing once","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/initialize(websiteToken:baseUrl:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/setUser(accessToken:identifier:identifierHash:name:email:phoneNumber:customAttributes:)"},{"text":" ","type":"text"},{"text":"have succeeded and the underlying WebSocket is connected. Events","type":"text"},{"text":" ","type":"text"},{"text":"produced before a subscriber attaches are not replayed.","type":"text"}]},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The closure-based P0 API (","type":"text"},{"type":"codeVoice","code":"Result<Void, GcBotErrors>"},{"text":" ","type":"text"},{"text":"twins) intentionally does not have a listener equivalent — the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"text":" surface here is the single supported way to observe","type":"text"},{"text":" ","type":"text"},{"text":"real-time events, matching the locked design decision that","type":"text"},{"text":" ","type":"text"},{"text":"delegate protocols feel foreign on iOS.","type":"text"}]}]}]}],"variants":[{"paths":["\/documentation\/gcwidgetsdk\/gcwidgetsdk\/chatevents"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.gamechange.GCWidgetSDK/documentation/GCWidgetSDK/GcChatEvent":{"navigatorTitle":[{"text":"GcChatEvent","kind":"identifier"}],"title":"GcChatEvent","i