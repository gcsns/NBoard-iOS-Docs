{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Initialize the SDK with the integrator’s website configuration."}],"identifier":{"url":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/initialize(websiteToken:baseUrl:certificatePins:socketHeaders:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"initialize"},{"kind":"text","text":"("},{"kind":"externalParam","text":"websiteToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"baseUrl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"certificatePins"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"socketHeaders"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"text":" : ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"] = [:]) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"websiteToken","content":[{"type":"paragraph","inlineContent":[{"text":"Website token identifying the widget inbox on the","type":"text"},{"text":" ","type":"text"},{"text":"backend. Issued by the widget admin console — never hardcoded","type":"text"},{"text":" ","type":"text"},{"text":"in a shipped client binary.","type":"text"}]}]},{"name":"baseUrl","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"REST base URL, e.g. "},{"type":"codeVoice","code":"\"https:\/\/wasp.example.com\""},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"WebSocket URL is derived automatically by swapping the scheme"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"https","type":"codeVoice"},{"text":"→","type":"text"},{"code":"wss","type":"codeVoice"},{"text":") and appending ","type":"text"},{"type":"codeVoice","code":"\/cable"},{"text":". Pass the fully-qualified","type":"text"},{"text":" ","type":"text"},{"text":"host — trailing slashes are stripped for you.","type":"text"}]}]},{"name":"certificatePins","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"SPKI SHA-256 pins for "},{"code":"baseUrl","type":"codeVoice"},{"type":"text","text":"’s host, in"},{"text":" ","type":"text"},{"type":"codeVoice","code":"sha256\/<base64>"},{"text":" form. Applied to both the REST client and the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"real-time socket. Generate them with "},{"type":"codeVoice","code":"scripts\/compute-spki-pin.sh"},{"text":".","type":"text"}]},{"inlineContent":[{"inlineContent":[{"text":"Mandatory.","type":"text"}],"type":"strong"},{"type":"text","text":" An empty set fails with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/certificatePinsRequired","isActive":true},{"text":", so an integration cannot","type":"text"},{"text":" ","type":"text"},{"text":"silently run on platform trust alone.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Hardcode these in your app. Do NOT fetch them from your"},{"type":"text","text":" "},{"type":"text","text":"backend"}]},{"type":"text","text":" — the opposite of the guidance for every other value"},{"text":" ","type":"text"},{"text":"here. A pin set fetched over the network is itself unpinned, so","type":"text"},{"text":" ","type":"text"},{"text":"anyone able to intercept that one call serves their own pins and","type":"text"},{"text":" ","type":"text"},{"text":"pinning stops meaning anything.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Pin the intermediate, not just the leaf.","type":"text"}]},{"text":" Leaf certificates are","type":"text"},{"text":" ","type":"text"},{"text":"short-lived and rotate automatically, so a leaf-only pin set stops","type":"text"},{"text":" ","type":"text"},{"text":"working the day it renews. Include the issuing intermediate — and","type":"text"},{"text":" ","type":"text"},{"text":"ideally a backup for a key not yet in service — so a rotation","type":"text"},{"text":" ","type":"text"},{"text":"cannot take chat down on every installed copy of the app, which","type":"text"},{"text":" ","type":"text"},{"text":"has no server-side fix.","type":"text"}],"type":"paragraph"}]},{"name":"socketHeaders","content":[{"inlineContent":[{"text":"Extra HTTP headers attached to the WebSocket","type":"text"},{"text":" ","type":"text"},{"text":"upgrade request (e.g. an API-gateway routing\/auth header). Empty","type":"text"},{"text":" ","type":"text"},{"text":"by default. Re-applied on every socket (re)connect. The SDK","type":"text"},{"text":" ","type":"text"},{"text":"ships no header values itself — pass tenant-specific ones here.","type":"text"}],"type":"paragraph"}]}]},{"kind":"mentions","mentions":["doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GettingStarted"]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"This is the first call every host must make. It stores the supplied","type":"text"},{"text":" ","type":"text"},{"text":"configuration in memory and then hits ","type":"text"},{"type":"codeVoice","code":"POST \/api\/v1\/widget\/config"},{"text":" ","type":"text"},{"text":"to fetch the widget ","type":"text"},{"type":"codeVoice","code":"auth_token"},{"text":", the contact id, and the pubsub","type":"text"},{"text":" ","type":"text"},{"text":"token used for the WebSocket subscription. All three are held in","type":"text"},{"text":" ","type":"text"},{"text":"memory on ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcChatConfig"},{"text":" for the lifetime of the app process —","type":"text"},{"text":" ","type":"text"},{"text":"nothing is persisted. Call this again on every cold start to","type":"text"},{"text":" ","type":"text"},{"text":"re-establish the session.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Call this method again on every cold start — the returned widget","type":"text"},{"text":" ","type":"text"},{"text":"config is short-lived, and a fresh fetch is the cheapest way to","type":"text"},{"text":" ","type":"text"},{"text":"ensure the ","type":"text"},{"type":"codeVoice","code":"x-auth-token"},{"text":" used by the chat UI is valid.","type":"text"}],"type":"paragraph"},{"text":"Example","level":2,"anchor":"Example","type":"heading"},{"syntax":"swift","code":["Task {","    do {","        try await GcWidgetSDK.shared.initialize(","            websiteToken:  \"sqUE…\",","            baseUrl:       \"https:\/\/wasp.example.com\",","            certificatePins: [","                \"sha256\/d6qzRu9zOECb90Uez27xWltNsj0e1Md7GkYYkVoZWmM=\", \/\/ leaf","                \"sha256\/YLh1dUR9y6Kja30RrAn7JKnbQG\/uEtLMkBgFF2Fuihg=\", \/\/ intermediate","                \"sha256\/Bl0i0xVQCJ7jUFOtfV8u1E0PIkBmVQoAcJ3PLTKKmXk=\"  \/\/ offline backup","            ],","            socketHeaders: [\"NI-wasp_nicorportal.ae\": \"••••••••••••••••\"]","        )","    } catch let err as GcBotErrors {","        print(\"init failed: \\(err.message) (\\(err.code))\")","    }","}"],"type":"codeListing"},{"style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/hostAppNotAuthorized","isActive":true},{"type":"text","text":" if this build of the SDK is not"},{"type":"text","text":" "},{"type":"text","text":"provisioned for the embedding app’s bundle identifier;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/insecureBaseURL","isActive":true},{"type":"text","text":" if "},{"type":"codeVoice","code":"baseUrl"},{"type":"text","text":" is not a valid HTTPS"},{"type":"text","text":" "},{"type":"text","text":"URL; "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/certificatePinsRequired","isActive":true},{"type":"text","text":" if "},{"type":"codeVoice","code":"certificatePins"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"empty; "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/invalidCertificatePins","isActive":true},{"type":"text","text":" if any pin is not in"},{"type":"text","text":" "},{"type":"codeVoice","code":"sha256\/<base64>"},{"type":"text","text":" form; "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/tlsPinningFailure","isActive":true},{"type":"text","text":" if the"},{"type":"text","text":" "},{"type":"text","text":"backend’s certificate chain does not present a pinned public key;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/internetIssue","isActive":true},{"type":"text","text":" if the device is offline;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/apiTimeout","isActive":true},{"type":"text","text":" if the config request times out;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/authentication","isActive":true},{"text":" if the website token is rejected;","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/serverError","isActive":true},{"type":"text","text":" for any other backend failure."}]}],"type":"aside"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Safe to call multiple times. Each call overwrites the","type":"text"},{"text":" ","type":"text"},{"text":"in-memory ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcChatConfig"},{"text":" and refreshes the stored auth token.","type":"text"},{"text":" ","type":"text"},{"text":"Do ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" call from a background thread.","type":"text"}]}],"type":"aside"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"The optional bearer ","type":"text"},{"type":"codeVoice","code":"accessToken"},{"text":" is not accepted here — it is","type":"text"},{"text":" ","type":"text"},{"text":"a parameter of","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/setUser(accessToken:identifier:identifierToken:name:email:phoneNumber:customAttributes:)"},{"text":".","type":"text"}]}],"type":"aside"},{"style":"note","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/setUser(accessToken:identifier:identifierToken:name:email:phoneNumber:customAttributes:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/openChatList(from:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/initialize(websiteToken:baseUrl:certificatePins:socketHeaders:completion:)"}]}],"type":"aside"}]}],"sections":[],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"initialize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"websiteToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"baseUrl","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"certificatePins"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"text":">, ","kind":"text"},{"kind":"externalParam","text":"socketHeaders"},{"text":": [","kind":"text"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"text":" : ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"throws"}],"role":"symbol","roleHeading":"Instance Method","externalID":"s:11GCWidgetSDK08GcWidgetB0C10initialize12websiteToken7baseUrl15certificatePins13socketHeadersySS_SSShySSGSDyS2SGtYaKF","symbolKind":"method","title":"initia