er":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"title":"setUser(accessToken:identifier:identifierToken:name:email:phoneNumber:customAttributes:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gcwidgetsdk\/gcwidgetsdk\/setuser(accesstoken:identifier:identifiertoken:name:email:phonenumber:customattributes:)"]}],"hierarchy":{"paths":[["doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK","doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK"]]},"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setUser","kind":"identifier"},{"text":"(","kind":"text"},{"text":"accessToken","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"identifier","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"identifierToken","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"email","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"phoneNumber","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"customAttributes","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"] = [:]) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"accessToken","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional bearer credential for infrastructure in"},{"type":"text","text":" "},{"type":"text","text":"front of the chat backend — an API gateway, for example. When"},{"type":"text","text":" "},{"type":"text","text":"supplied it rides as "},{"type":"codeVoice","code":"Authorization: Bearer <token>"},{"type":"text","text":" on every"},{"type":"text","text":" "},{"type":"text","text":"subsequent SDK request; when omitted (the default) no"},{"type":"text","text":" "},{"type":"codeVoice","code":"Authorization"},{"type":"text","text":" header is sent at all. It is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" part of the"},{"type":"text","text":" "},{"type":"text","text":"session contract: the session is authenticated by "},{"type":"codeVoice","code":"X-Auth-Token"},{"type":"text","text":" "},{"type":"text","text":"and, at sign-in, by "},{"type":"codeVoice","code":"identifierToken"},{"type":"text","text":". Passing one here rather"},{"type":"text","text":" "},{"type":"text","text":"than at "},{"type":"codeVoice","code":"initialize"},{"type":"text","text":" keeps it on the same call as the identity it"},{"type":"text","text":" "},{"type":"text","text":"accompanies, and out of the SDK bootstrap."}]}]},{"name":"identifier","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stable external identifier — typically the E.164"},{"type":"text","text":" "},{"type":"text","text":"phone number. Must exactly match the token’s subject."}]}]},{"name":"identifierToken","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Freshly minted signed assertion for"},{"type":"text","text":" "},{"type":"codeVoice","code":"identifier"},{"type":"text","text":", produced by the integrator’s backend. Opaque to the"},{"type":"text","text":" "},{"type":"text","text":"SDK; sent as "},{"type":"codeVoice","code":"identifier_token"},{"type":"text","text":". Must carry "},{"inlineContent":[{"type":"codeVoice","code":"pur: \"login\""}],"type":"strong"},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"this proof is checked against "},{"type":"codeVoice","code":"PATCH \/contact\/set_user"},{"type":"text","text":", and the"},{"type":"text","text":" "},{"type":"text","text":"server refuses any other purpose with"},{"type":"text","text":" "},{"type":"codeVoice","code":"401 invalid_identity_assertion: pur mismatch"},{"type":"text","text":". The same applies"},{"type":"text","text":" "},{"type":"text","text":"when you call this from"},{"type":"text","text":" "},{"type":"codeVoice","code":"GcBotSessionListener\/onTokenExpired()"},{"type":"text","text":": that path re-identifies"},{"type":"text","text":" "},{"type":"text","text":"the customer, so it is a login proof, not a refresh one."}]}]},{"name":"name","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full display name shown to agents."}]}]},{"name":"email","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional email. Omit (or pass "},{"type":"codeVoice","code":"nil"},{"type":"text","text":") to leave unchanged"},{"type":"text","text":" "},{"type":"text","text":"on the server."}]}]},{"name":"phoneNumber","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional phone number (expected to be the same"},{"type":"text","text":" "},{"type":"text","text":"E.164 value as "},{"type":"codeVoice","code":"identifier"},{"type":"text","text":" in the common case)."}]}]},{"name":"customAttributes","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional key\/value pairs attached to the"},{"type":"text","text":" "},{"type":"text","text":"contact record. Useful for plan tiers, region flags, or any"},{"type":"text","text":" "},{"type":"text","text":"host-specific metadata agents should see."}]}]}],"kind":"parameters"},{"kind":"mentions","mentions":["doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GettingStarted"]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Sends ","type":"text"},{"code":"PATCH \/api\/v1\/widget\/contact\/set_user","type":"codeVoice"},{"text":" with the supplied","type":"text"},{"text":" ","type":"text"},{"text":"contact fields and, critically, the pre-computed HMAC identifier","type":"text"},{"text":" ","type":"text"},{"text":"hash. If the response carries a new ","type":"text"},{"code":"widget_auth_token","type":"codeVoice"},{"text":" the SDK","type":"text"},{"text":" ","type":"text"},{"text":"stores it, replacing the one fetched at ","type":"text"},{"code":"initialize","type":"codeVoice"},{"text":" time.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call this:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"on first login after collecting user details;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"whenever the host app learns new identity fields (profile"},{"type":"text","text":" "},{"type":"text","text":"completion, email verification, phone change);"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"on returning-user flows if you need to rotate the auth token."}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","text":"Identity token","anchor":"Identity-token"},{"type":"paragraph","inlineContent":[{"code":"identifierToken","type":"codeVoice"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"must"}]},{"text":" be a short-lived assertion signed by your","type":"text"},{"text":" ","type":"text"},{"text":"backend with a secret that never leaves your servers, sent to the","type":"text"},{"text":" ","type":"text"},{"text":"server as ","type":"text"},{"code":"identifier_token","type":"codeVoice"},{"text":". The SDK deliberately does not ship any","type":"text"},{"text":" ","type":"text"},{"text":"signing key — a client-side secret is a client-side secret, and","type":"text"},{"text":" ","type":"text"},{"text":"trivially extractable from a shipped binary. The value you pass is","type":"text"},{"text":" ","type":"text"},{"text":"forwarded verbatim and never parsed by the SDK.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The token’s subject and the "},{"type":"codeVoice","code":"identifier"},{"type":"text","text":" sent alongside it must match"},{"type":"text","text":" "},{"type":"text","text":"exactly (including any country-code prefix), or the server rejects it."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Fetch a fresh one for every call."}]},{"type":"text","text":" The token is single-use and"},{"type":"text","text":" "},{"type":"text","text":"short-lived; a cached one is rejected as a replay. Never hold onto the"},{"type":"text","text":" "},{"type":"text","text":"value you passed here — the SDK does not, and asks for a new one"},{"type":"text","text":" "},{"type":"text","text":"through "},{"type":"codeVoice","code":"GcBotSessionListener\/provideRefreshAssertion()"},{"type":"text","text":" when it"},{"type":"text","text":" "},{"type":"text","text":"needs to rotate the session by itself."}]},{"anchor":"Example","text":"Example","type":"heading","level":2},{"code":["\/\/ Your backend mints a fresh signed assertion for the identifier.","let token = try await YourBackend.identityToken(for: phoneE164)","","try await GcWidgetSDK.shared.setUser(","    accessToken: backendAccessToken,","    identifier: phoneE164,","    identifierToken: token,","    name: \"Jane Merchant\",","    email: \"jane@example.com\",","    phoneNumber: phoneE164,","    customAttributes: [\"plan\": \"gold\", \"region\": \"APAC\"]",")"],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Throws","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/unauthorizedAccess","isActive":true},{"type":"text","text":" if called before"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/initialize(websiteToken:baseUrl:certificatePins:socketHeaders:)","isActive":true},{"type":"text","text":" has completed;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/authentication","isActive":true},{"type":"text","text":" if the token is rejected by the"},{"type":"text","text":" "},{"type":"text","text":"backend; "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/internetIssue","isActive":true},{"type":"text","text":" if offline;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/apiTimeout","isActive":true},{"type":"text","text":" on request timeout;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/serverError","isActive":true},{"type":"text","text":" for any other backend failure."}]}]},{"style":"warning","name":"Warning","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An expired, reused, or tampered "},{"type":"codeVoice","code":"identifierToken"},{"type":"text","text":" will be"},{"type":"text","text":" "},{"type":"text","text":"rejected with "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/authentication","isActive":true},{"type":"text","text":". Do not attempt to"},{"type":"text","text":" "},{"type":"text","text":"synthesize or cache the token on the client."}]}]},{"style":"note","name":"See Also","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/initialize(websiteToken:baseUrl:certificatePins:socketHeaders:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/setUser(accessToken:identifier:identifierToken:name:email:phoneNumber:customAttributes:completion:)","isActive":true}]}]}]}],"references":{"doc://com.gamechange.GCWidgetSDK/documentation/GCWidgetSDK/GcBotErrors/internetIssue":{"role":"symbol","kind":"symbol","title":"internetIssue","abstract":[],"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotErrors\/internetIssue","url":"\/documentation\/gcwidgetsdk\/gcboterrors\/internetissue","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"internetIssue"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GcBotErrors","preciseIdentifier":"s:11GCWidgetSDK11GcBotErrorsV"}],"type":"topic"},"doc://com.gamechange.GCWidgetSDK/documentation/GCWidgetSDK/GcWidgetSDK":{"role":"symbol","kind":"symbol","title":"GcWidgetSDK","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK","abstract":[{"text":"The top-level entry point for the Game Change AI support widget SDK.","type":"text"}],"navigatorTitle":[{"kin