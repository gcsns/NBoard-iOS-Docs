{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"url":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotSessionListener","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"Supplies identity tokens on demand, and hears when a session is over."}],"topicSections":[{"title":"Instance Methods","identifiers":["doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotSessionListener\/onSessionExpired()","doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotSessionListener\/onTokenExpired(purpose:)"],"generated":true,"anchor":"Instance-Methods"}],"metadata":{"modules":[{"name":"GCWidgetSDK"}],"symbolKind":"protocol","role":"symbol","roleHeading":"Protocol","externalID":"s:11GCWidgetSDK20GcBotSessionListenerP","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GcBotSessionListener","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"GcBotSessionListener"}],"title":"GcBotSessionListener"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gcwidgetsdk\/gcbotsessionlistener"]}],"hierarchy":{"paths":[["doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GcBotSessionListener","kind":"identifier"},{"text":" : AnyObject","kind":"text"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GettingStarted"]},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"inlineContent":[{"text":"Register with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/setSessionListener(_:)","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Why-the-SDK-asks-rather-than-holding-a-token","text":"Why the SDK asks rather than holding a token","level":2},{"inlineContent":[{"text":"An identity token is single-use and short-lived — how short is the server’s","type":"text"},{"text":" ","type":"text"},{"text":"to decide, and it can change without a client release — so one handed over","type":"text"},{"text":" ","type":"text"},{"text":"in advance is worthless by the time it is needed. Only your backend can","type":"text"},{"text":" ","type":"text"},{"text":"mint one, so the SDK asks for each rotation as it happens — which also makes","type":"text"},{"text":" ","type":"text"},{"text":"caching one impossible by construction, and caching is the mistake this","type":"text"},{"text":" ","type":"text"},{"text":"contract exists to prevent.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"The-sequence","text":"The sequence","level":2},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A request comes back rejected. "},{"type":"strong","inlineContent":[{"type":"text","text":"The request is held"}]},{"type":"text","text":", not failed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotSessionListener\/onTokenExpired(purpose:)"},{"type":"text","text":" is called with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotTokenPurpose\/refresh"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Return a token and the SDK rotates the session and replays the held"},{"type":"text","text":" "},{"type":"text","text":"request — the customer sees nothing."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If rotation is impossible — a revoked credential, a session that no"},{"type":"text","text":" "},{"type":"text","text":"longer exists — the SDK rebuilds one and calls you again with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotTokenPurpose\/login"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If that also fails, or you return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to either, the session is over:"},{"type":"text","text":" "},{"type":"text","text":"everything is torn down and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotSessionListener\/onSessionExpired()"},{"type":"text","text":" is called."}]}]}]},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotTokenPurpose\/logout"},{"text":" arrives on the same method when the host calls","type":"text"},{"text":" ","type":"text"},{"code":"removeUser()","type":"codeVoice"},{"text":". It is the one call you may decline freely — the sign-out","type":"text"},{"text":" ","type":"text"},{"text":"happens either way.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You have ","type":"text"},{"code":"30 seconds","type":"codeVoice"},{"text":" to answer each call. After that the held request fails","type":"text"},{"text":" ","type":"text"},{"text":"and the session is closed, so answer promptly — returning ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" is a fast,","type":"text"},{"text":" ","type":"text"},{"text":"honest answer when you cannot mint a token.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Memory","text":"Memory","level":2},{"inlineContent":[{"text":"The SDK holds the listener ","type":"text"},{"type":"strong","inlineContent":[{"text":"weakly","type":"text"}]},{"text":", so it will not keep your object (or","type":"text"},{"text":" ","type":"text"},{"text":"the view controller it belongs to) alive. Keep your own strong reference:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["final class SupportService {","    private let sessionHandler = SessionHandler()   \/\/ strong, owned here","","    init() {","        GcWidgetSDK.shared.setSessionListener(sessionHandler)","    }","}"]},{"type":"heading","anchor":"Example","text":"Example","level":2},{"syntax":"swift","type":"codeListing","code":["final class SessionHandler: GcBotSessionListener {","","    func onTokenExpired(purpose: GcBotTokenPurpose) async -> String? {","        guard AppSession.isSignedIn else { return nil }","        return try? await YourBackend.identityToken(","            for: AppSession.userId, purpose: purpose.rawValue","        )","    }","","    func onSessionExpired() {","        AppSession.clear()","        routeToLogin()","    }","}"]}],"kind":"content"}],"references":{"doc://com.gamechange.GCWidgetSDK/documentation/GCWidgetSDK/GcBotSessionListener/onSessionExpired()":{"title":"onSessionExpired()","kind":"symbol","abstract":[{"text":"The chat session is over and all session state has been cleared: no","type":"text"},{"text":" ","type":"text"},{"text":"token arrived in time, or the ones that did were refused.","type":"text"}],"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotSessionListener\/onSessionExpired()","type":"topic","required":true,"url":"\/documentation\/gcwidgetsdk\/gcbotsessionlistener\/onsessionexpired()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onSessionExpired","kind":"identifier"},{"kind":"text","text":"()"}]},"doc://com.gamechange.GCWidgetSDK/documentation/GCWidgetSDK/GettingStarted":{"role":"article","kind":"article","title":"Getting started","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GettingStarted","abstract":[{"type":"text","text":"Integrate "},{"type":"codeVoice","code":"GCWidgetSDK"},{"text":" into your iOS app end-to-end — from project","type":"text"},{"type":"text","text":" "},{"text":"setup, through backend prep, to shipping a production-ready support","type":"text"},{"type":"text","text":" "},{"type":"text","text":"entry point."}],"url":"\/documentation\/gcwidgetsdk\/gettingstarted","type":"topic"},"doc://com.gamechange.GCWidgetSDK/documentation/GCWidgetSDK/GcBotTokenPurpose/refresh":{"role":"symbol","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotTokenPurpose\/refresh","url":"\/documentation\/gcwidgetsdk\/gcbottokenpurpose\/refresh","kind":"symbol","abstract":[{"type":"text","text":"Rotating the token of a session that still exists —"},{"type":"text","text":" "},{"code":"POST \/session\/refresh","type":"codeVoice"},{"type":"text","text":". Same customer, same conversation, new expiry."}],"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"refresh"}],"title":"GcBotTokenPurpose.refresh"},"doc://com.gamechange.GCWidgetSDK/documentation/GCWidgetSDK":{"abstract":[{"type":"text","text":"Drop-in iOS support widget — one import, one method call, full chat UI."}],"url":"\/documentation\/gcwidgetsdk","role":"collection","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK","type":"topic","title":"GCWidgetSDK","kind":"symbol"},"doc://com.gamechange.GCWidgetSDK/documentation/GCWidgetSDK/GcBotTokenPurpose/login":{"title":"GcBotTokenPurpose.login","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcBotTokenPurpose\/login","abstract":[{"text":"Identifying the customer on a session — ","type":"text"},{"type":"codeVoice","code":"PATCH \/contact\/set_user"},{"text":".","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/gcwidgetsdk\/gcbottokenpurpose\/login","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","k