{"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Once the user taps through the welcome screens, the widget pushes them"},{"type":"text","text":" "},{"type":"text","text":"into the conversation list. The list is fully self-contained — there is"},{"type":"text","text":" "},{"type":"text","text":"no SDK-level configuration for what it shows, which tabs appear, or how"},{"type":"text","text":" "},{"type":"text","text":"rows are formatted. The SDK automatically paginates the backend feed,"},{"type":"text","text":" "},{"type":"text","text":"listens to websocket updates for in-place changes, and re-applies tab"},{"type":"text","text":" "},{"type":"text","text":"and search filters locally."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Host app involvement:"}]},{"type":"text","text":" none. Calling"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/initializeSDK(viewController:token:name:email:phone:)"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"the complete integration; this screen and everything it navigates to is"},{"type":"text","text":" "},{"type":"text","text":"rendered, updated, and dismissed by the SDK."}],"type":"paragraph"},{"anchor":"Anatomy","level":2,"text":"Anatomy","type":"heading"},{"syntax":null,"code":["┌───────────────────────────────────────────────────┐","│  ←   My Conversations                             │  Navigation bar","├───────────────────────────────────────────────────┤","│  🔍  Search conversations...                      │  Search field","│                                                   │","│  ┌ All ┐  POS Terminal   Payment   General   ... │  Filter tabs","│  └─────┘                                          │","├───────────────────────────────────────────────────┤","│  Webhook not firing on checkout       Payment     │","│  1 day ago                                        │","│  ─────────────────────────────────────────────────│","│  Printer Error 07 after update      POS Terminal  │","│  1 day ago                          ✓ RESOLVED    │","│  ─────────────────────────────────────────────────│","│  …                                                │","│                                            ╭───╮  │","│                                            │ + │  │  FAB","│                                            ╰───╯  │","└───────────────────────────────────────────────────┘"],"type":"codeListing"},{"inlineContent":[{"text":"Each element is a discrete visual component:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Component"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"What it does"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Back button","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dismisses the widget (returns to the host app)."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Title"}]}],[{"type":"paragraph","inlineContent":[{"text":"“My Conversations” — fixed.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Search field","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Filters the visible rows locally by title, type, sender name, or conversation ID."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Filter tabs"}]}],[{"type":"paragraph","inlineContent":[{"text":"Scope the list to ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"All"}]},{"type":"text","text":", a specific conversation type (POS Terminal \/ Payment \/ General), or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Resolved"}]},{"type":"text","text":". The selected tab gets a dark pill background."}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Row","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conversation title + relative timestamp on the left; category pill (and an optional “✓ RESOLVED” badge) on the right."}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Floating action button","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Opens the new-conversation bottom sheet where the user picks a topic.","type":"text"}]}]]],"type":"table"},{"text":"Behaviour","level":2,"anchor":"Behaviour","type":"heading"},{"text":"Loading data","level":3,"anchor":"Loading-data","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"On first appearance the SDK fetches the first page of conversations from","type":"text"},{"text":" ","type":"text"},{"text":"the backend. A pull-to-refresh gesture forces a fresh fetch regardless of","type":"text"},{"text":" ","type":"text"},{"text":"cache age. Scrolling to the last row triggers pagination for the next","type":"text"},{"text":" ","type":"text"},{"text":"page when available.","type":"text"}]},{"text":"Real-time updates","level":3,"anchor":"Real-time-updates","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The SDK subscribes to a websocket channel while the screen is visible.","type":"text"},{"text":" ","type":"text"},{"text":"Incoming messages or status changes update the relevant row without a","type":"text"},{"text":" ","type":"text"},{"text":"network round-trip; new conversations appear at the top of the list.","type":"text"}]},{"text":"Filtering","level":3,"anchor":"Filtering","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Switching tabs is a pure client-side filter — no network call. Typing in","type":"text"},{"text":" ","type":"text"},{"text":"the search field narrows the already-filtered list further, so search","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"always respects the active tab."}]},{"level":3,"type":"heading","anchor":"Empty-state","text":"Empty state"},{"type":"paragraph","inlineContent":[{"text":"When the active filter has no conversations, the list is replaced by an","type":"text"},{"text":" ","type":"text"},{"text":"empty state with a peach card icon, a tab-aware heading, and a short","type":"text"},{"text":" ","type":"text"},{"text":"sentence inviting the user to start a new conversation. The body copy","type":"text"},{"text":" ","type":"text"},{"text":"adapts to the selected tab:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Body"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"All","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"“Tap the + button to start your first conversation — we’re here to help.”","type":"text"}],"type":"emphasis"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"POS Terminal"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"“Start a conversation about POS terminals, hardware, or printing issues.”","type":"text"}],"type":"emphasis"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Payment"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"“Start a conversation about payment integrations, APIs, or online payment issues.”","type":"text"}],"type":"emphasis"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"General"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"“Start a general support conversation — we’ll route it for you.”"}],"type":"emphasis"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Resolved"}]}],[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"text":"“Resolved conversations will appear here once you close them.”","type":"text"}]}]}]]]},{"anchor":"Tapping-a-row","type":"heading","text":"Tapping a row","level":3},{"inlineContent":[{"text":"Pushes the chat messages screen for that conversation. If the tapped","type":"text"},{"text":" ","type":"text"},{"text":"conversation continues from a previously resolved one, the chat screen","type":"text"},{"type":"text","text":" "},{"type":"text","text":"shows the “continued from resolved conversation” banner card so agents"},{"type":"text","text":" "},{"type":"text","text":"see the thread of context."}],"type":"paragraph"},{"text":"Starting a new conversation","level":3,"anchor":"Starting-a-new-conversation","type":"heading"},{"inlineContent":[{"type":"text","text":"Tapping the floating "},{"inlineContent":[{"type":"text","text":"+"}],"type":"strong"},{"type":"text","text":" button presents a bottom sheet asking the user"},{"type":"text","text":" "},{"type":"text","text":"to pick a topic. On selection, a fresh conversation is opened in the chat"},{"type":"text","text":" "},{"text":"screen.","type":"text"}],"type":"paragraph"},{"text":"Styling","level":2,"anchor":"Styling","type":"heading"},{"inlineContent":[{"type":"text","text":"Every color, font, radius, and spacing value on this screen pulls from"},{"type":"text","text":" "},{"type":"text","text":"the SDK’s internal "},{"code":"DesignTokens","type":"codeVoice"},{"type":"text","text":". The typeface is bundled "},{"type":"strong","inlineContent":[{"text":"Noto Sans","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"(Regular \/ Medium \/ SemiBold \/ Bold). See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/DesignSystem"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"visual vocabulary.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Customisation hooks (theme, per-tenant colours) are not exposed in the","type":"text"},{"text":" ","type":"text"},{"text":"public API; the look is intentionally uniform across SDK consumers so","type":"text"},{"text":" ","type":"text"},{"text":"support conversations feel identical regardless of the host app.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/ConversationList","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The primary inbox your users see after onboarding — a SwiftUI list of their"},{"type":"text","text":" "},{"type":"text","text":"support threads, grouped by topic and filterable by status."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK"]]},"metadata":{"role":"article","title":"The Conversation List Screen","modules":[{"name":"GCWidgetSDK"}],"roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gcwidgetsdk\/conversationlist"]}],"references":{"doc://com.gamechange.GCWidgetSDK/documentation/GCWidgetSDK/DesignSystem":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/DesignSystem","url":"\/documentation\/gcwidgetsdk\/designsystem","abstract":[{"text":"The typography, colors, and spacing that give every widget screen a","type":"text"},{"text":" ","type":"text"},{"text":"consistent look.","type":"text"}],"title":"Design System"},"doc://com.gamechange.GCWidgetSDK/documentation/GCWidgetSDK/GcWidgetSDK/initializeSDK(viewController:token:name:email:phone:)":{"type":"topic","kind":"symbol","url":"\/documentation\/gcwidgetsdk\/gcwidgetsdk\/initializesdk(viewcontroller:token:name:email:phone:)","title":"initializeSDK(viewController:token:name:email:phone:)","abstract":[{"text":"Presents the full chat UI modally on top of ","type":"text"},{"type":"codeVoice","code":"viewController"},{"type":"text","text":"."}],"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetS