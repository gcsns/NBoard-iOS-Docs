{"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"This guide walks you through every step from dropping the framework in","type":"text"},{"text":" ","type":"text"},{"text":"your project to presenting the support widget from a real screen. The","type":"text"},{"text":" ","type":"text"},{"text":"public surface is small by design: a singleton","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/shared","type":"reference"},{"text":") with three methods. Everything else — onboarding,","type":"text"},{"text":" ","type":"text"},{"text":"conversation list, chat, websocket updates, dismissal — is owned by the","type":"text"},{"text":" ","type":"text"},{"text":"SDK.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Requirements"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Xcode 15 or newer"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"iOS 17.0 deployment target minimum","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Swift 5.9+","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Step-1-Add-the-framework-to-your-project","level":2,"type":"heading","text":"Step 1 — Add the framework to your project"},{"inlineContent":[{"type":"text","text":"Drop "},{"type":"codeVoice","code":"GCWidgetSDK.framework"},{"type":"text","text":" into your app target’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Frameworks,"},{"type":"text","text":" "},{"type":"text","text":"Libraries, and Embedded Content"}]},{"type":"text","text":" section:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your app target in Xcode’s project navigator.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Open the ","type":"text"},{"inlineContent":[{"type":"text","text":"General"}],"type":"strong"},{"text":" tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Under ","type":"text"},{"inlineContent":[{"type":"text","text":"Frameworks, Libraries, and Embedded Content"}],"type":"strong"},{"text":", click ","type":"text"},{"inlineContent":[{"type":"text","text":"+"}],"type":"strong"},{"text":" →","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Add Other…"}],"type":"strong"},{"text":" → ","type":"text"},{"inlineContent":[{"type":"text","text":"Add Files…"}],"type":"strong"},{"text":" and pick the framework.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Set ","type":"text"},{"inlineContent":[{"type":"text","text":"Embed"}],"type":"strong"},{"text":" to ","type":"text"},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"text":". (This is required — the framework","type":"text"},{"text":" ","type":"text"},{"text":"ships bundled fonts and image assets that must travel inside the app","type":"text"},{"text":" ","type":"text"},{"text":"bundle.)","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"If your app’s deployment target is lower than iOS 17.0, raise it to 17.0"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"strong","inlineContent":[{"type":"text","text":"Build Settings → iOS Deployment Target"}]},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Step-2-Configure-your-Infoplist","level":2,"type":"heading","text":"Step 2 — Configure your Info.plist"},{"inlineContent":[{"text":"The widget can capture photos, record voice notes, and attach files, so","type":"text"},{"text":" ","type":"text"},{"text":"the host app must declare the relevant usage descriptions. Add the keys","type":"text"},{"text":" ","type":"text"},{"text":"you expect users to hit:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Why"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSCameraUsageDescription"}]}],[{"inlineContent":[{"type":"text","text":"Taking a photo of a problem (receipt, error screen)."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSPhotoLibraryUsageDescription"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Attaching screenshots from the user’s library."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSMicrophoneUsageDescription"}]}],[{"inlineContent":[{"type":"text","text":"Recording a short voice note inside a conversation."}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"Write the usage strings from the end-user’s perspective — “We’ll use your","type":"text"},{"text":" ","type":"text"},{"text":"camera to attach a photo to your support conversation.” — iOS shows them","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"verbatim in the permission prompt."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Step 3 — Import the SDK","anchor":"Step-3-Import-the-SDK"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Anywhere you intend to open the widget:"}]},{"type":"codeListing","code":["import GCWidgetSDK"],"syntax":"swift"},{"type":"heading","anchor":"Step-4-Open-the-widget","text":"Step 4 — Open the widget","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/initializeSDK(viewController:token:name:email:phone:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"from the view controller you want the widget to present over — typically"},{"type":"text","text":" "},{"type":"text","text":"a “Contact Support” button handler:"}]},{"type":"codeListing","code":["import UIKit","import GCWidgetSDK","","final class SettingsViewController: UIViewController {","","    @IBAction func contactSupportTapped(_ sender: UIButton) {","        GcWidgetSDK.shared.initializeSDK(","            viewController: self,","            name:  currentUser.fullName,","            email: currentUser.email,","            phone: currentUser.phoneNumberE164","        )","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"That single call:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Authenticates with the configured backend using your website token."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Upserts the contact identity (name \/ email \/ phone) so support agents"},{"type":"text","text":" "},{"type":"text","text":"see the latest details."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Presents the welcome screens modally on top of ","type":"text"},{"type":"codeVoice","code":"viewController"},{"text":" in","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"full-screen."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Navigates the user into the conversation list, where they can resume"},{"type":"text","text":" "},{"type":"text","text":"an existing thread or start a new one."}],"type":"paragraph"}]}]},{"level":3,"anchor":"Identity-fields-are-optional","type":"heading","text":"Identity fields are optional"},{"inlineContent":[{"type":"text","text":"All of "},{"type":"codeVoice","code":"name"},{"type":"text","text":", "},{"type":"codeVoice","code":"email"},{"type":"text","text":", and "},{"type":"codeVoice","code":"phone"},{"type":"text","text":" are "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"-able. Pass what you know at"},{"type":"text","text":" "},{"type":"text","text":"call time; the SDK reuses the last known values from previous sessions"},{"text":" ","type":"text"},{"text":"if you omit them. You can open the widget completely anonymously:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["GcWidgetSDK.shared.initializeSDK(viewController: self)"],"syntax":"swift"},{"type":"heading","anchor":"Phone-number-format","level":3,"text":"Phone number format"},{"type":"paragraph","inlineContent":[{"text":"Pass E.164 format (","type":"text"},{"type":"codeVoice","code":"\"+15551234567\""},{"type":"text","text":"). Numbers without a leading "},{"type":"codeVoice","code":"+"},{"type":"text","text":" are"},{"text":" ","type":"text"},{"text":"interpreted as Indian (","type":"text"},{"type":"codeVoice","code":"+91"},{"text":") numbers for contact hashing — pass","type":"text"},{"type":"text","text":" "},{"text":"fully-qualified international numbers if you target other regions.","type":"text"}]},{"type":"heading","level":2,"text":"Step 5 — (Optional) Update the contact off-session","anchor":"Step-5-Optional-Update-the-contact-off-session"},{"type":"paragraph","inlineContent":[{"text":"When your host app learns new details about a user between support","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"sessions, push them to the backend without opening the widget:"}]},{"type":"codeListing","code":["GcWidgetSDK.shared.setUser(","    name:  \"Jane Merchant\",","    email: \"jane@example.com\",","    phone: \"+15551234567\"",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any field left "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" is untouched — the SDK only sends keys you provide."},{"text":" ","type":"text"},{"text":"Next time the user opens the widget, the support agent sees the new","type":"text"},{"text":" ","type":"text"},{"text":"values.","type":"text"}]},{"type":"heading","level":2,"text":"Step 6 — (Optional) Check widget history","anchor":"Step-6-Optional-Check-widget-history"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/isUserLoggedIn","type":"reference","isActive":true},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"type":"text","text":" once"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/initializeSDK(viewController:token:name:email:phone:)","type":"reference","isActive":true},{"text":" has","type":"text"},{"type":"text","text":" "},{"type":"text","text":"been called successfully at least once on the device. Use it to decide"},{"type":"text","text":" "},{"text":"whether to show a first-run explainer, or to re-open the widget silently","type":"text"},{"type":"text","text":" "},{"text":"on cold start:","type":"text"}]},{"syntax":"swift","code":["override func viewDidAppear(_ animated: Bool) {","    super.viewDidAppear(animated)","    if GcWidgetSDK.shared.isUserLoggedIn {","        GcWidgetSDK.shared.initializeSDK(viewController: self)","    } else {","        presentOnboardingThenOpenSupport()","    }","}"],"type":"codeListing"},{"level":2,"anchor":"Threading","type":"heading","text":"Threading"},{"inlineContent":[{"type":"text","text":"All three public methods must be called on the main thread. The SDK runs"},{"type":"text","text":" "},{"type":"text","text":"networking and socket work on background queues internally, but every"},{"type":"text","text":" "},{"type":"text","text":"UI mutation hops back to main before touching a view — so integration"},{"type":"text","text":" "},{"text":"from a UIKit action handler or SwiftUI button callback is always safe.","type":"text"}],"type":"paragraph"},{"anchor":"What-the-user-sees","level":2,"text":"What the user sees","type":"heading"},{"inlineContent":[{"type":"text","text":"After "},{"type":"codeVoice","code":"initializeSDK"},{"type":"text","text":" is called the user lands on the welcome \/ onboarding"},{"text":" ","type":"text"},{"type":"text","text":"screens. From there they proceed to the conversation list — their inbox"},{"type":"text","text":" "},{"type":"text","text":"of support threads — where they can search, filter by topic, resume an"},{"type":"text","text":" "},{"type":"text","text":"existing conversation, or tap the floating "},{"inlineContent":[{"type":"text","text":"+"}],"type":"strong"},{"type":"text","text":" button to start a new"},{"type":"text","text":" "},{"type":"text","text":"one. Real-time updates (new agent messages, status changes) arrive over"},{"type":"text","text":" "},{"type":"text","text":"a websocket while the widget is visible. The entire flow is owned and"},{"type":"text","text":" "},{"type":"text","text":"dismissed by the SDK; the host app is not involved until the user is"},{"type":"text","text":" "},{"type":"text","text":"back in your app."}],"type":"paragraph"},{"anchor":"Minimal-integration-checklist","type":"heading","text":"Minimal integration checklist","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Added "},{"type":"codeVoice","code":"GCWidgetSDK.framework"},{"type":"text","text":" with "},{"inlineContent":[{"text":"Embed & Sign","type":"text"}],"type":"strong"}]}],"checked":false},{"content":[{"type":"paragraph","inlineContent":[{"text":"Deployment target ≥ iOS 17.0","type":"text"}]}],"checked":false},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" usage descriptions added for camera \/ photo library \/ microphone"}],"type":"paragraph"}],"checked":false},{"content":[{"inlineContent":[{"code":"import GCWidgetSDK","type":"codeVoice"},{"type":"text","text":" in the calling file"}],"type":"paragraph"}],"checked":false},{"content":[{"inlineContent":[{"text":"One call to ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.gamechange.GCWidgetSDK\/documentation\/GCWidgetSDK\/GcWidgetSDK\/shared","isActive":